{
  "name": "ch57x-config-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file web editor and WebHID uploader for ch57x-keyboard-tool YAML mappings",
  "license": "ISC",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node test/run.mjs",
    "fetch-refs": "sh scripts/fetch-refs.sh",
    "build:ref": "NODE_PATH=./node_modules esbuild test/reference/ref_entry.ts --bundle --platform=node --format=cjs --outfile=test/reference/ref.cjs --log-level=warning"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "zod": "^4.6.7"
  }
}
