+#[cfg(test)]
+mod fork_oracle {
+    use super::*;
+    use std::io::BufRead;
+    fn hexs(v: &[u8]) -> String { v.iter().map(|b| format!("{:02x}", b)).collect::<Vec<_>>().join(" ") }
+    #[test]
+    fn dump() {
+        let path = match std::env::var("ORACLE_ACTIONS") { Ok(p) => p, Err(_) => return };
+        let f = std::io::BufReader::new(std::fs::File::open(path).unwrap());
+        let keys: Vec<(&str, Key)> = vec![
+            ("b0", Key::Button(0)), ("b5", Key::Button(5)), ("b11", Key::Button(11)), ("b14", Key::Button(14)), ("b15", Key::Button(15)),
+            ("k0ccw", Key::Knob(0, KnobAction::RotateCCW)), ("k0press", Key::Knob(0, KnobAction::Press)), ("k1cw", Key::Knob(1, KnobAction::RotateCW)),
+            ("k2press", Key::Knob(2, KnobAction::Press)), ("k3ccw", Key::Knob(3, KnobAction::RotateCCW)), ("k3press", Key::Knob(3, KnobAction::Press)),
+            ("k3cw", Key::Knob(3, KnobAction::RotateCW)), ("k4press", Key::Knob(4, KnobAction::Press)),
+        ];
+        for line in f.lines() {
+            let action = line.unwrap();
+            if action.is_empty() { continue; }
+            let m = match action.parse::<Macro>() { Ok(m) => m, Err(_) => { println!("FORK|{}|-|-|ERRPARSE", action); continue; } };
+            for layer in [0u8, 1u8, 2u8] {
+                for (kn, k) in keys.iter() {
+                    let mut out: Vec<Vec<u8>> = vec![];
+                    match k884x::oracle::bind(layer, *k, &m, &mut out) {
+                        Ok(()) => println!("FORK|{}|{}|{}|OK|{}", action, layer, kn, out.iter().map(|p| hexs(p)).collect::<Vec<_>>().join(" ; ")),
+                        Err(e) => println!("FORK|{}|{}|{}|ERR|{}", action, layer, kn, e),
+                    }
+                }
+            }
+        }
+    }
+}
